{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/runtime-verification.schema.json",
  "title": "Fabric runtime verification v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "observed_at", "status", "checks", "limitations"],
  "properties": {
    "schema_version": {"const": "fabricctl.runtime-verification/v1"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["verified", "partial", "failed"]},
    "synthetic_id": {"type": "string", "minLength": 1, "maxLength": 253},
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 253},
          "status": {"enum": ["pass", "fail", "unverified"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
    "then": {
      "properties": {
        "checks": {"items": {"properties": {"status": {"const": "pass"}}}},
        "limitations": {"maxItems": 0}
      }
    }
  }]
}
