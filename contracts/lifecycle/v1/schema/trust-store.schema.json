{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/trust-store.schema.json",
  "title": "Fabric public verification trust store v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "fabricctl.trust-store/v1"},
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key_id", "public_key", "purposes"],
        "properties": {
          "key_id": {"type": "string", "minLength": 1, "maxLength": 253},
          "public_key": {"type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"},
          "purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["lifecycle-approval", "release-artifact", "management-receipt"]}}
        }
      }
    }
  }
}
