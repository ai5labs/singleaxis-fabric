{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/operation-receipt.schema.json",
  "title": "Fabric lifecycle operation receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "operation_id", "operation", "actor", "started_at", "completed_at", "bundle_digest", "plan_digest", "target_digest", "approval_ref", "outcome", "recovery", "verification", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "fabricctl.operation-receipt/v1"},
    "operation_id": {"type": "string", "minLength": 1}, "operation": {"enum": ["install", "upgrade", "rollback"]}, "actor": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
    "bundle_digest": {"$ref": "#/$defs/digest"}, "plan_digest": {"$ref": "#/$defs/digest"}, "target_digest": {"$ref": "#/$defs/digest"},
    "approval_ref": {"type": "string"}, "source_revision": {"type": "string"}, "effective_revision": {"type": "string"}, "effective_digest": {"$ref": "#/$defs/digest"},
    "outcome": {"enum": ["succeeded", "failed", "incomplete"]}, "recovery": {"type": "string", "minLength": 1},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "coverage", "limitations"], "properties": {"status": {"enum": ["verified", "partial", "unverified", "failed"]}, "coverage": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}}},
    "previous_receipt_digest": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
