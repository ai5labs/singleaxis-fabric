{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/signed-connection-receipt.schema.json",
  "title": "Signed Fabric management connection receipt v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "key_id", "receipt", "signature"],
  "properties": {
    "schema_version": {"const": "fabricctl.signed-connection-receipt/v1"},
    "key_id": {"$ref": "#/$defs/reference"},
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "connection_id", "mode", "endpoint_origin", "workload_ref", "effective_digest", "connected_at", "credential_stored"],
      "properties": {
        "schema_version": {"const": "fabricctl.connection-receipt/v1"},
        "connection_id": {"$ref": "#/$defs/reference"},
        "mode": {"enum": ["singleaxis-saas", "singleaxis-private"]},
        "endpoint_origin": {"type": "string", "format": "uri", "pattern": "^https://[^/?#]+$"},
        "tenant_ref": {"$ref": "#/$defs/reference"},
        "workload_ref": {"$ref": "#/$defs/reference"},
        "effective_digest": {"$ref": "#/$defs/digest"},
        "connected_at": {"type": "string", "format": "date-time"},
        "credential_stored": {"const": false}
      }
    },
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"}
  }
}
