{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/approval-envelope.schema.json",
  "title": "Detached Fabric lifecycle approval v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "approval_id", "issuer", "key_id", "issued_at", "expires_at", "scope", "signature"],
  "properties": {
    "schema_version": {"const": "fabricctl.approval-envelope/v1"},
    "approval_id": {"$ref": "#/$defs/reference"},
    "issuer": {"$ref": "#/$defs/reference"},
    "key_id": {"$ref": "#/$defs/reference"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "bundle_digest", "plan_digest", "target_digest"],
      "properties": {
        "operation": {"enum": ["install", "upgrade", "rollback"]},
        "bundle_digest": {"$ref": "#/$defs/digest"},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "target_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "signature": {"type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"}
  }
}
