{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/pairing-request.schema.json",
  "title": "Fabric management pairing request v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "bundle_digest", "target_digest", "effective_digest", "target", "workload"],
  "properties": {
    "schema_version": {"const": "fabricctl.pairing-request/v1"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "target_digest": {"$ref": "#/$defs/digest"},
    "effective_digest": {"$ref": "#/$defs/digest"},
    "target": {"$ref": "#/$defs/target"},
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {
        "type": {"enum": ["spiffe", "oidc", "kubernetes-service-account"]},
        "reference": {"$ref": "#/$defs/reference"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "cluster_uid", "release_name"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "context": {"type": "string"},
        "cluster_uid": {"type": "string", "minLength": 1},
        "namespace": {"type": "string"},
        "release_name": {"type": "string", "minLength": 1}
      }
    }
  }
}
