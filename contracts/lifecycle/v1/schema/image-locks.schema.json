{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/image-locks.schema.json",
  "title": "Fabric release image locks v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "images"],
  "properties": {
    "schema_version": {"const": "fabricctl.image-locks/v1"},
    "release": {"type": "string", "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "images": {
      "type": "array", "minItems": 1, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component", "repository", "digest"],
        "properties": {
          "component": {"enum": ["otel-collector", "otel-redactor", "nemo-sidecar", "fabric-relay", "presidio-sidecar", "langfuse", "langfuse-bootstrap", "redteam-runner", "update-agent"]},
          "repository": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
