{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/operation-plan.schema.json",
  "title": "Fabric lifecycle operation plan v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "operation", "readiness", "plan_digest", "bundle_digest", "target_digest", "target_version", "target", "artifacts", "effects", "approval", "compatibility"],
  "properties": {
    "schema_version": {"const": "fabricctl.operation-plan/v1"},
    "operation": {"enum": ["install", "upgrade", "rollback"]},
    "readiness": {"enum": ["draft", "mutation-ready"]},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "target_digest": {"$ref": "#/$defs/digest"},
    "source_version": {"type": "string"},
    "target_version": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "approval": {"enum": ["required", "interactive"]},
    "compatibility": {"$ref": "#/$defs/compatibility"}
  },
  "allOf": [{"if": {"properties": {"readiness": {"const": "mutation-ready"}}}, "then": {"properties": {"target": {"required": ["cluster_uid"]}}}}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {"type": "object", "additionalProperties": false, "required": ["backend", "release_name"], "properties": {"backend": {"type": "string"}, "context": {"type": "string"}, "cluster_uid": {"type": "string", "minLength": 1}, "namespace": {"type": "string"}, "release_name": {"type": "string", "minLength": 1}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"], "properties": {"kind": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["action", "resource"], "properties": {"action": {"enum": ["apply", "create", "update", "replace", "delete"]}, "resource": {"type": "string", "minLength": 1}}},
    "compatibility": {"type": "object", "additionalProperties": false, "properties": {"minimum_current_version": {"type": "string"}, "maximum_current_version": {"type": "string"}, "rollback_revision": {"type": "string"}}}
  }
}
