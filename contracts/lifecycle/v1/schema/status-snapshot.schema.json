{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/status-snapshot.schema.json",
  "title": "Fabric runtime status snapshot v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "observed_at", "target", "desired_digest", "drift", "delivery", "components"],
  "properties": {
    "schema_version": {"const": "fabricctl.status-snapshot/v1"}, "observed_at": {"type": "string", "format": "date-time"},
    "target": {"$ref": "#/$defs/target"}, "desired_digest": {"$ref": "#/$defs/digest"}, "effective_digest": {"$ref": "#/$defs/digest"},
    "drift": {"enum": ["unknown", "none-detected", "detected"]}, "delivery": {"enum": ["unverified", "verified", "degraded", "failed"]},
    "components": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "ready", "detail"], "properties": {"name": {"type": "string"}, "ready": {"type": "boolean"}, "revision": {"type": "string"}, "detail": {"type": "string"}}}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "release_name"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "context": {"type": "string"},
        "cluster_uid": {"type": "string"},
        "namespace": {"type": "string"},
        "release_name": {"type": "string", "minLength": 1}
      }
    }
  }
}
