{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/lifecycle/v1/support-manifest.schema.json",
  "title": "Fabric sanitized support manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "created_at", "generator", "files", "excluded", "uploaded", "bundle_digest"],
  "properties": {
    "schema_version": {"const": "fabricctl.support-manifest/v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "commit"],
      "properties": {"version": {"type": "string"}, "commit": {"type": "string"}}
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "class", "sha256"],
        "properties": {
          "path": {"enum": ["bundle-verification-report.json", "environment.json", "operation-receipt.json"]},
          "class": {"enum": ["derived-bundle-integrity", "allowlisted-runtime-identity", "verified-operation-evidence"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "excluded": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "uploaded": {"const": false},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
