{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/assurance/v1/assurance-finding-v1.schema.json",
  "title": "SingleAxis Fabric AssuranceFinding v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "record_version",
    "run_id",
    "lifecycle_stage",
    "source_type",
    "subject",
    "versions",
    "result",
    "evaluator_provenance",
    "evidence_references",
    "timestamps",
    "status",
    "appeal",
    "supersedes_finding_id",
    "superseded_by_finding_id"
  ],
  "properties": {
    "schema_version": {"const": "singleaxis.fabric.assurance-finding/v1"},
    "finding_id": {"$ref": "#/$defs/stableId"},
    "record_version": {"type": "integer", "minimum": 1},
    "run_id": {"$ref": "#/$defs/stableId"},
    "lifecycle_stage": {"enum": ["pre_deployment", "runtime_continuous", "incident"]},
    "source_type": {"enum": ["deterministic_test", "llm_judge", "red_team", "human_review"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "digest",
        "reference",
        "agent_id",
        "agent_version",
        "deployment_id",
        "execution_id",
        "decision_id",
        "incident_id",
        "trace_id",
        "span_id"
      ],
      "properties": {
        "kind": {"enum": ["agent_bundle", "test_case", "trace_projection", "model_output", "tool_invocation", "policy_decision", "incident_record"]},
        "digest": {"$ref": "#/$defs/sha256"},
        "reference": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]},
        "agent_id": {"$ref": "#/$defs/stableId"},
        "agent_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "deployment_id": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "execution_id": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "decision_id": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "incident_id": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
        "trace_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$"},
        "span_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"span_id": {"type": "string"}}, "required": ["span_id"]},
          "then": {"properties": {"trace_id": {"type": "string"}}}
        }
      ]
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_version", "suite_version", "policy_version"],
      "properties": {
        "rubric_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "suite_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
        "policy_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 100}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "severity", "score", "confidence", "confidence_basis", "reason_code"],
      "properties": {
        "outcome": {"enum": ["pass", "fail", "inconclusive", "error"]},
        "severity": {"enum": ["none", "low", "medium", "high", "critical"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_basis": {"enum": ["calibrated", "heuristic", "not_reported"]},
        "reason_code": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 128}
      }
    },
    "evaluator_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "evaluator_version", "artifact_digest", "execution_mode", "model", "principal_ref"],
      "properties": {
        "evaluator_id": {"$ref": "#/$defs/stableId"},
        "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 100},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "execution_mode": {"enum": ["deterministic", "model", "human"]},
        "model": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "model_id", "model_version", "configuration_digest"],
              "properties": {
                "provider": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 80},
                "model_id": {"type": "string", "minLength": 1, "maxLength": 160},
                "model_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 100},
                "configuration_digest": {"$ref": "#/$defs/sha256"}
              }
            },
            {"type": "null"}
          ]
        },
        "principal_ref": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]}
      }
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "type", "digest", "reference"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/stableId"},
          "type": {"enum": ["test_report", "trace_projection", "evaluation_record", "red_team_transcript_ref", "review_record", "policy_record", "incident_record"]},
          "digest": {"$ref": "#/$defs/sha256"},
          "reference": {"$ref": "#/$defs/reference"}
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_started_at", "observed_at", "finalized_at", "status_changed_at"],
      "properties": {
        "run_started_at": {"type": "string", "format": "date-time"},
        "observed_at": {"type": "string", "format": "date-time"},
        "finalized_at": {"type": "string", "format": "date-time"},
        "status_changed_at": {"type": "string", "format": "date-time"}
      }
    },
    "status": {"enum": ["final", "appealed", "superseded"]},
    "appeal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["appeal_id", "filed_at", "grounds_code"],
          "properties": {
            "appeal_id": {"$ref": "#/$defs/stableId"},
            "filed_at": {"type": "string", "format": "date-time"},
            "grounds_code": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 128}
          }
        },
        {"type": "null"}
      ]
    },
    "supersedes_finding_id": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]},
    "superseded_by_finding_id": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "null"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"lifecycle_stage": {"const": "runtime_continuous"}}, "required": ["lifecycle_stage"]},
      "then": {
        "properties": {
          "subject": {
            "properties": {"deployment_id": {"$ref": "#/$defs/stableId"}},
            "anyOf": [
              {"properties": {"execution_id": {"$ref": "#/$defs/stableId"}}},
              {"properties": {"decision_id": {"$ref": "#/$defs/stableId"}}},
              {"properties": {"trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"lifecycle_stage": {"const": "incident"}}, "required": ["lifecycle_stage"]},
      "then": {
        "properties": {
          "subject": {
            "properties": {
              "deployment_id": {"$ref": "#/$defs/stableId"},
              "incident_id": {"$ref": "#/$defs/stableId"}
            },
            "anyOf": [
              {"properties": {"execution_id": {"$ref": "#/$defs/stableId"}}},
              {"properties": {"decision_id": {"$ref": "#/$defs/stableId"}}},
              {"properties": {"trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"source_type": {"const": "deterministic_test"}}, "required": ["source_type"]},
      "then": {
        "properties": {
          "versions": {"properties": {"suite_version": {"type": "string"}}},
          "evaluator_provenance": {"properties": {"execution_mode": {"const": "deterministic"}, "model": {"type": "null"}, "principal_ref": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"source_type": {"const": "llm_judge"}}, "required": ["source_type"]},
      "then": {
        "properties": {
          "versions": {"properties": {"rubric_version": {"type": "string"}}},
          "evaluator_provenance": {"properties": {"execution_mode": {"const": "model"}, "model": {"type": "object"}, "principal_ref": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"source_type": {"const": "red_team"}}, "required": ["source_type"]},
      "then": {
        "properties": {
          "versions": {"properties": {"suite_version": {"type": "string"}}},
          "evaluator_provenance": {"properties": {"execution_mode": {"enum": ["deterministic", "model"]}, "principal_ref": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"source_type": {"const": "human_review"}}, "required": ["source_type"]},
      "then": {
        "properties": {
          "versions": {"properties": {"policy_version": {"type": "string"}}},
          "evaluator_provenance": {"properties": {"execution_mode": {"const": "human"}, "model": {"type": "null"}, "principal_ref": {"$ref": "#/$defs/stableId"}}}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "appealed"}}, "required": ["status"]},
      "then": {"properties": {"appeal": {"type": "object"}, "superseded_by_finding_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
      "then": {"properties": {"appeal": {"type": "null"}, "superseded_by_finding_id": {"$ref": "#/$defs/stableId"}}}
    },
    {
      "if": {"properties": {"status": {"const": "final"}}, "required": ["status"]},
      "then": {"properties": {"appeal": {"type": "null"}, "superseded_by_finding_id": {"type": "null"}}}
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "string", "pattern": "^(?:artifact|evidence|trace|urn|https|s3|gs)://[^\\s]+$", "maxLength": 500}
  }
}
