{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-installation-plan.schema.json",
  "title": "Fabric offline installation plan v1",
  "description": "Deterministic, non-mutating, network-free plan bound to exact deployment and install-target resources.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "readiness", "operation", "deployment_obligations", "deployment", "target", "distribution", "profile", "backend", "actions", "prerequisites"],
  "properties": {
    "schema_version": {"const": "fabricctl.installation-plan/v1"},
    "status": {"const": "pass"},
    "readiness": {"const": "unverified"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "mutating"],
      "properties": {
        "network": {"const": false},
        "mutating": {"const": false}
      }
    },
    "deployment_obligations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assurance_level", "integration", "roles", "references", "prerequisites"],
      "properties": {
        "assurance_level": {"enum": ["A0", "A1", "A2", "A3"]},
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "artifact"],
          "properties": {
            "mode": {"enum": ["sdk", "adapter", "gateway", "otlp"]},
            "artifact": {"$ref": "#/$defs/text"}
          }
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "plane", "artifact", "purpose"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "plane": {"enum": ["connect", "control", "observe", "assurance"]},
              "artifact": {"$ref": "#/$defs/text"},
              "purpose": {"$ref": "#/$defs/text"}
            }
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "field", "reference"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "field": {"$ref": "#/$defs/fieldPath"},
              "reference": {"$ref": "#/$defs/reference"}
            }
          }
        },
        "prerequisites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "summary"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "status": {"const": "required"},
              "summary": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    },
    "deployment": {"$ref": "#/$defs/resourceBinding"},
    "target": {"$ref": "#/$defs/resourceBinding"},
    "distribution": {"$ref": "#/$defs/distribution"},
    "profile": {"$ref": "#/$defs/profile"},
    "backend": {"$ref": "#/$defs/backend"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "type", "target"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 128},
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["validate", "render", "verify"]},
          "target": {"$ref": "#/$defs/reference"}
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "status", "description"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 128},
          "id": {"$ref": "#/$defs/id"},
          "status": {"const": "required"},
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "fieldPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z][A-Za-z0-9]*(?:\\.[A-Za-z][A-Za-z0-9]*)*$"
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactRef", "version", "digest"],
      "properties": {
        "artifactRef": {
          "type": "string",
          "minLength": 9,
          "maxLength": 512,
          "pattern": "^oci://[A-Za-z0-9](?:[A-Za-z0-9._:/-]*[A-Za-z0-9])?$"
        },
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "digest"],
      "properties": {
        "name": {"enum": ["permissive-dev", "eu-ai-act-high-risk"]},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "helm"],
      "properties": {
        "type": {"const": "helm"},
        "helm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["context", "namespace", "releaseName", "createNamespace"],
          "properties": {
            "context": {"$ref": "#/$defs/reference"},
            "namespace": {"$ref": "#/$defs/dnsLabel"},
            "releaseName": {"$ref": "#/$defs/dnsLabel"},
            "createNamespace": {"type": "boolean"}
          }
        }
      }
    }
  }
}
