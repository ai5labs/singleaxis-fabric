{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-secret-requirements.schema.json",
  "title": "FabricSecretRequirements v1alpha1",
  "description": "Unresolved secret metadata required by a Fabric installation; secret values cannot be represented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "status", "requirements"],
  "properties": {
    "apiVersion": {"const": "fabric.singleaxis.dev/v1alpha1"},
    "kind": {"const": "FabricSecretRequirements"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}}
    },
    "status": {"const": "unresolved"},
    "requirements": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "namespace", "keys", "purpose", "consumer"],
        "properties": {
          "name": {"$ref": "#/$defs/dnsLabel"},
          "namespace": {"$ref": "#/$defs/dnsLabel"},
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,251}[A-Za-z0-9])?$"
            }
          },
          "purpose": {"$ref": "#/$defs/reference"},
          "consumer": {"$ref": "#/$defs/reference"}
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"
    }
  }
}
