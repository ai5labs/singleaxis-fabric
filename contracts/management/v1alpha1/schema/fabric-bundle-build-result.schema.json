{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-bundle-build-result.schema.json",
  "title": "fabricctl bundle build result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "readiness"],
  "properties": {
    "schema_version": {"const": "fabricctl.bundle-build/v1"},
    "status": {"enum": ["pass", "fail"]},
    "readiness": {"const": "unverified"},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/diagnostic"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {"required": ["bundle_digest", "artifacts"], "not": {"required": ["diagnostics"]}},
      "else": {"required": ["diagnostics"], "not": {"anyOf": [{"required": ["bundle_digest"]}, {"required": ["artifacts"]}]}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "summary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"},
        "severity": {"const": "error"},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    }
  }
}
