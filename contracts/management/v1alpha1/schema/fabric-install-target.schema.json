{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-install-target.schema.json",
  "title": "FabricInstallTarget v1alpha1",
  "description": "Digest-pinned Kubernetes Helm installation target for one FabricDeployment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "fabric.singleaxis.dev/v1alpha1"},
    "kind": {"const": "FabricInstallTarget"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentRef", "distribution", "profile", "backend"],
      "properties": {
        "deploymentRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "digest"],
          "properties": {
            "name": {"$ref": "#/$defs/name"},
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        "distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifactRef", "version", "digest"],
          "properties": {
            "artifactRef": {
              "type": "string",
              "minLength": 9,
              "maxLength": 512,
              "pattern": "^oci://[A-Za-z0-9](?:[A-Za-z0-9._:/-]*[A-Za-z0-9])?$"
            },
            "version": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            },
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "digest"],
          "properties": {
            "name": {"enum": ["permissive-dev", "eu-ai-act-high-risk"]},
            "digest": {"$ref": "#/$defs/digest"}
          }
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "helm"],
          "properties": {
            "type": {"const": "helm"},
            "helm": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context", "namespace", "releaseName", "createNamespace"],
              "properties": {
                "context": {"$ref": "#/$defs/nonSecretReference"},
                "namespace": {"$ref": "#/$defs/dnsLabel"},
                "releaseName": {"$ref": "#/$defs/dnsLabel"},
                "createNamespace": {"type": "boolean"}
              }
            }
          }
        },
        "bindings": {"$ref": "#/$defs/bindings"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "properties": {"name": {"const": "eu-ai-act-high-risk"}},
                "required": ["name"]
              }
            },
            "required": ["profile"]
          },
          "then": {
            "required": ["bindings"],
            "properties": {
              "bindings": {"required": ["tenantId", "exporter", "updateTrust"]}
            }
          },
          "else": {
            "not": {"required": ["bindings"]}
          }
        }
      ]
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"
    },
    "dnsLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/name"}}
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonSecretReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "exporter", "updateTrust"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/nonSecretReference"},
        "exporter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "egress"],
          "properties": {
            "endpoint": {
              "type": "string",
              "minLength": 12,
              "maxLength": 512,
              "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$"
            },
            "egress": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cidrs", "ports"],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "maxLength": 49,
                    "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
                  }
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["protocol", "port"],
                    "properties": {
                      "protocol": {"const": "TCP"},
                      "port": {"type": "integer", "minimum": 1, "maximum": 65535}
                    }
                  }
                }
              }
            }
          }
        },
        "updateTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyId", "publicKey"],
          "properties": {
            "keyId": {"$ref": "#/$defs/nonSecretReference"},
            "publicKey": {
              "type": "string",
              "pattern": "^ed25519:[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    }
  }
}
