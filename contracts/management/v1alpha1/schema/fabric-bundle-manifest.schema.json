{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-bundle-manifest.schema.json",
  "title": "Fabric offline bundle manifest v1",
  "description": "Deterministic byte-digest index for the five non-manifest files in an Offline Install Bundle v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "self_exclusion", "files", "bundle_digest", "generator"],
  "properties": {
    "schema_version": {"const": "fabricctl.bundle-manifest/v1"},
    "self_exclusion": {"const": "bundle-manifest.json"},
    "files": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/file", "properties": {"path": {"const": "fabric-values.yaml"}}},
        {"$ref": "#/$defs/file", "properties": {"path": {"const": "install-target.yaml"}}},
        {"$ref": "#/$defs/file", "properties": {"path": {"const": "installation-plan.json"}}},
        {"$ref": "#/$defs/file", "properties": {"path": {"const": "secrets-required.yaml"}}},
        {"$ref": "#/$defs/file", "properties": {"path": {"const": "singleaxis.yaml"}}}
      ],
      "items": false
    },
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": {"const": "fabricctl"},
        "version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "enum": ["singleaxis.yaml", "install-target.yaml", "fabric-values.yaml", "secrets-required.yaml", "installation-plan.json"]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
