{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-deployment.schema.json",
  "title": "FabricDeployment v1alpha1",
  "description": "Reference-only desired state for a Fabric agent deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "fabric.singleaxis.dev/v1alpha1"},
    "kind": {"const": "FabricDeployment"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assuranceLevel", "connection", "observe"],
      "properties": {
        "assuranceLevel": {"enum": ["A0", "A1", "A2", "A3"]},
        "connection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "tenantIdFrom"],
          "properties": {
            "mode": {"enum": ["sdk", "adapter", "gateway", "otlp"]},
            "tenantIdFrom": {"$ref": "#/$defs/reference"},
            "workloadIdentityRef": {"$ref": "#/$defs/reference"}
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileRef"],
          "properties": {
            "profileRef": {"$ref": "#/$defs/reference"},
            "policyRef": {"$ref": "#/$defs/reference"},
            "authorizationRef": {"$ref": "#/$defs/reference"},
            "piiRef": {"$ref": "#/$defs/reference"},
            "guardrailRef": {"$ref": "#/$defs/reference"},
            "escalationRef": {"$ref": "#/$defs/reference"}
          }
        },
        "observe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contentMode"],
          "properties": {
            "contentMode": {"enum": ["metadata-only", "hash-only", "content-ref"]},
            "relayRef": {"$ref": "#/$defs/reference"}
          }
        },
        "assurance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planRef"],
          "properties": {"planRef": {"$ref": "#/$defs/reference"}}
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approvalRef"],
          "properties": {"approvalRef": {"$ref": "#/$defs/reference"}}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"assuranceLevel": {"enum": ["A1", "A2", "A3"]}}},
          "then": {
            "properties": {"observe": {"required": ["contentMode", "relayRef"]}}
          }
        },
        {
          "if": {"properties": {"assuranceLevel": {"enum": ["A2", "A3"]}}},
          "then": {"required": ["controls", "assurance", "rollout"]}
        },
        {
          "if": {"properties": {"assuranceLevel": {"const": "A3"}}},
          "then": {
            "properties": {
              "connection": {
                "required": ["mode", "tenantIdFrom", "workloadIdentityRef"]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._:/-]{0,251}[A-Za-z0-9])?$"
    }
  }
}
