{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fabric.singleaxis.dev/contracts/management/v1alpha1/fabric-bundle-verification-report.schema.json",
  "title": "fabricctl offline bundle verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "status", "readiness", "operation", "checks", "diagnostics"],
  "properties": {
    "schema_version": {"const": "fabricctl.bundle-verification-report/v1"},
    "scope": {"const": "offline"},
    "status": {"enum": ["pass", "fail"]},
    "readiness": {"const": "unverified"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "mutating"],
      "properties": {"network": {"const": false}, "mutating": {"const": false}}
    },
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "status": {"enum": ["pass", "fail"]}
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "severity": {"const": "error"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {"required": ["bundle_digest"], "properties": {"diagnostics": {"maxItems": 0}}},
      "else": {"not": {"required": ["bundle_digest"]}, "properties": {"diagnostics": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"}
  }
}
