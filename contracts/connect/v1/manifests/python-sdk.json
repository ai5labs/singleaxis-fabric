{
  "schema_version": "singleaxis.fabric.connect-capability/v1",
  "connector_id": "singleaxis.fabric.python-sdk",
  "display_name": "SingleAxis Fabric Python SDK",
  "release": {"version": "0.7.0", "maturity": "beta", "distribution": "python-package"},
  "implementation": {"kind": "in_process_sdk", "deployment_modes": ["application"]},
  "compatibility": {
    "activity_contract": "1.0.0",
    "fabric_versions": ">=0.7.0,<1.0.0",
    "runtimes": ["CPython >=3.11"],
    "protocols": ["OpenTelemetry API", "W3C Trace Context through host OpenTelemetry configuration"]
  },
  "observation": {
    "semantic_surfaces": [
      {"surface": "decision_boundary", "source": "native_hook"},
      {"surface": "llm_operation", "source": "native_hook"},
      {"surface": "tool_operation", "source": "native_hook"},
      {"surface": "retrieval", "source": "caller_reported"},
      {"surface": "memory", "source": "caller_reported"},
      {"surface": "side_effect", "source": "caller_reported"},
      {"surface": "policy_verdict", "source": "caller_reported"},
      {"surface": "guardrail_verdict", "source": "native_hook"},
      {"surface": "authorization_verdict", "source": "caller_reported"},
      {"surface": "escalation", "source": "caller_reported"},
      {"surface": "evaluation", "source": "caller_reported"},
      {"surface": "framework_lifecycle", "source": "native_hook"},
      {"surface": "generic_interaction", "source": "caller_reported"},
      {"surface": "file_access_metadata", "source": "caller_reported"}
    ],
    "decision_semantics": "native",
    "coverage_basis": "In-process Decision and child-span context managers plus explicit record methods and optional framework adapters."
  },
  "control": {
    "interposition": "in_process",
    "agent_runtime_actions": ["block", "redact", "authorize", "escalate"],
    "telemetry_pipeline_actions": []
  },
  "content": {
    "raw_content_behavior": "configurable_raw",
    "default_raw_capture": false,
    "pre_egress_redaction": "operator_configurable",
    "sensitive_field_allowlist": true
  },
  "identity": {
    "source": "application_configuration",
    "strength": "asserted",
    "tenant_partitioning": "validated"
  },
  "authentication": {
    "ingress_supported": ["in_process_boundary"],
    "ingress_default": "in_process_boundary",
    "egress_supported": ["none", "delegated_to_exporter"],
    "egress_default": "none",
    "credential_handling": "The SDK accepts no Fabric service credential; exporter credentials belong to the host-configured OpenTelemetry exporter."
  },
  "context_propagation": {
    "w3c_tracecontext": {"receive": true, "inject": false, "preserve": true},
    "baggage": "pass_through",
    "correlation_limitations": [
      "Propagation across network or process boundaries depends on host OpenTelemetry instrumentation.",
      "Caller-reported operations are complete only when application code records them."
    ]
  },
  "data_egress": {
    "network_egress": false,
    "protocols": ["OpenTelemetry in-process API"],
    "transport_security": "delegated",
    "destinations": "local_only",
    "default_destination": null
  },
  "verification_evidence": [
    {"type": "conformance_test", "path": "sdk/python/tests/test_conformance.py", "claim": "Executes declared public activity-contract scenarios."},
    {"type": "unit_test", "path": "sdk/python/tests/test_decision.py", "claim": "Exercises decision identity, correlation, event, content, and control behavior."}
  ],
  "known_blind_spots": [
    "Uninstrumented application branches, subprocesses, and off-the-shelf agent internals are not visible.",
    "Tenant and agent identifiers are validated assertions, not cryptographically bound workload identity.",
    "Raw LLM or tool content can be opted into per call and then depends on downstream redaction policy.",
    "The SDK does not itself prove exporter delivery, backend retention, or evidence immutability."
  ]
}
