{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "SingleAxis Fabric NeMo sidecar values",
  "description": "Strict public configuration contract for deterministic or operator-supplied NeMo rails.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "$ref": "#/definitions/imagePullSecrets" },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "name": { "type": "string", "maxLength": 253 }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": { "$ref": "#/definitions/kubernetesObject" },
    "securityContext": { "$ref": "#/definitions/kubernetesObject" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "$ref": "#/definitions/port" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenSecret"],
      "properties": {
        "tokenSecret": { "$ref": "#/definitions/secretKeyReference" }
      }
    },
    "resources": { "$ref": "#/definitions/kubernetesObject" },
    "livenessProbe": { "$ref": "#/definitions/kubernetesObject" },
    "readinessProbe": { "$ref": "#/definitions/kubernetesObject" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } },
    "affinity": { "$ref": "#/definitions/kubernetesObject" },
    "topologySpreadConstraints": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } },
    "railsConfigMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mountPath"],
      "properties": {
        "name": { "type": "string", "maxLength": 253 },
        "mountPath": { "type": "string", "pattern": "^/" }
      }
    },
    "starterRails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "literalFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "allowPassthrough": { "type": "boolean" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^[0-9]+%$" }] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressFrom", "egressTo"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressFrom": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } },
        "egressTo": { "type": "array", "items": { "$ref": "#/definitions/kubernetesObject" } }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "version": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "starterRails": { "properties": { "enabled": { "const": true } } } }
      },
      "then": { "properties": { "allowPassthrough": { "const": false } } }
    },
    {
      "if": {
        "properties": {
          "railsConfigMap": { "properties": { "name": { "maxLength": 0 } } },
          "starterRails": { "properties": { "enabled": { "const": true } } }
        }
      },
      "then": {
        "properties": {
          "literalFilter": { "properties": { "enabled": { "const": true } } },
          "allowPassthrough": { "const": false }
        }
      }
    },
    {
      "if": {
        "properties": {
          "railsConfigMap": { "properties": { "name": { "maxLength": 0 } } },
          "starterRails": { "properties": { "enabled": { "const": false } } }
        }
      },
      "then": { "properties": { "allowPassthrough": { "const": true } } }
    },
    {
      "if": {
        "properties": {
          "auth": { "properties": { "tokenSecret": { "properties": { "name": { "minLength": 1 } } } } }
        }
      },
      "then": {
        "properties": {
          "auth": { "properties": { "tokenSecret": { "properties": { "key": { "minLength": 1 } } } } }
        }
      }
    }
  ],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "kubernetesObject": { "type": "object", "additionalProperties": true },
    "stringMap": { "type": "object", "additionalProperties": { "type": "string" } },
    "secretKeyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": { "type": "string", "maxLength": 253 },
        "key": { "type": "string", "maxLength": 253 }
      }
    },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  }
}
