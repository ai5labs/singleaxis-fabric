{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "labelSelector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "operator"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "operator": {"type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
              "values": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "podSelector": {"$ref": "#/definitions/labelSelector"},
        "namespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidr"],
          "properties": {
            "cidr": {
              "type": "string",
              "oneOf": [
                {"pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[1-9]|[12][0-9]|3[0-2])$"},
                {"pattern": "^[0-9A-Fa-f:]+/(?:[1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"}
              ]
            },
            "except": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  },
  "required": ["mode", "destination", "persistence", "queue", "retry", "debugExporter"],
  "properties": {
    "mode": {"type": "string", "enum": ["development", "production"]},
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"type": "object"},
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "service": {"type": "object"},
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tls"],
      "properties": {
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serverCertificateSecret", "clientCASecret"],
          "properties": {
            "serverCertificateSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "certKey", "privateKeyKey"],
              "properties": {
                "name": {"type": "string"},
                "certKey": {"type": "string", "minLength": 1},
                "privateKeyKey": {"type": "string", "minLength": 1}
              }
            },
            "clientCASecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "allowedEndpoints", "compression", "timeout", "tls", "auth"],
      "properties": {
        "endpoint": {"type": "string"},
        "allowedEndpoints": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "compression": {"type": "string", "enum": ["", "gzip", "zstd", "none"]},
        "timeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["insecure", "insecureSkipVerify", "caSecret", "clientCertificateSecret"],
          "properties": {
            "insecure": {"type": "boolean"},
            "insecureSkipVerify": {"type": "boolean"},
            "caSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
            },
            "clientCertificateSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "certKey", "privateKeyKey"],
              "properties": {
                "name": {"type": "string"},
                "certKey": {"type": "string", "minLength": 1},
                "privateKeyKey": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headerName", "secretRef"],
          "properties": {
            "headerName": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
            "secretRef": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {"name": {"type": "string"}, "key": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "persistence": {"type": "object"},
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "compactionDirectory", "numConsumers", "queueSize", "blockOnOverflow"],
      "properties": {
        "directory": {"type": "string", "pattern": "^/var/lib/fabric-relay/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"},
        "compactionDirectory": {"type": "string", "pattern": "^/var/lib/fabric-relay/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*(?:/[A-Za-z0-9_-]+(?:[.][A-Za-z0-9_-]+)*)*$"},
        "numConsumers": {"type": "integer", "minimum": 1},
        "queueSize": {"type": "integer", "minimum": 1},
        "blockOnOverflow": {"type": "boolean"}
      }
    },
    "retry": {"type": "object"},
    "debugExporter": {"type": "object"},
    "memoryLimiter": {"type": "object"},
    "batch": {"type": "object"},
    "telemetry": {"type": "object"},
    "resources": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "podDisruptionBudget": {"type": "object"},
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "ingressFrom", "egressTo", "destinationPort", "dnsNamespaceSelector", "dnsPodSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFrom": {"type": "array", "items": {"$ref": "#/definitions/networkPolicyPeer"}},
        "egressTo": {"type": "array", "items": {"$ref": "#/definitions/networkPolicyPeer"}},
        "destinationPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "dnsNamespaceSelector": {"$ref": "#/definitions/labelSelector"},
        "dnsPodSelector": {"$ref": "#/definitions/labelSelector"}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "fabric": {"type": "object"},
    "global": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "production"}}},
      "then": {
        "properties": {
          "destination": {
            "properties": {
              "endpoint": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
              "allowedEndpoints": {"minItems": 1},
              "tls": {"properties": {"insecure": {"const": false}, "insecureSkipVerify": {"const": false}}}
            }
          },
          "persistence": {"properties": {"enabled": {"const": true}}},
          "debugExporter": {"properties": {"enabled": {"const": false}}},
          "retry": {"properties": {"maxElapsedTime": {"const": "0s"}}},
          "receiver": {
            "properties": {
              "tls": {
                "properties": {
                  "serverCertificateSecret": {"properties": {"name": {"minLength": 1}}},
                  "clientCASecret": {"properties": {"name": {"minLength": 1}}}
                }
              }
            }
          },
          "networkPolicy": {
            "properties": {
              "enabled": {"const": true},
              "ingressFrom": {"minItems": 1},
              "egressTo": {"minItems": 1}
            }
          }
        }
      }
    }
  ]
}
